const martyrsGrid = document.getElementById('martyrs-grid');
const searchInput = document.getElementById('search-input');
const regionFilter = document.getElementById('region-filter');
const martyrsCountEl = document.getElementById('martyrs-count');
const modal = document.getElementById('martyr-modal');
const modalContent = document.getElementById('modal-content');
const closeModalBtn = document.getElementById('close-modal');

const bgAudio = document.getElementById('bg-audio');
const audioToggleBtn = document.getElementById('audio-toggle');
const audioIcon = document.getElementById('audio-icon');
const audioText = document.getElementById('audio-text');
let isPlaying = false;

audioToggleBtn.addEventListener('click', () => {
    if (isPlaying) {
        bgAudio.pause();
        audioIcon.textContent = '▶';
        audioText.textContent = 'تشغيل الموسيقى';
    } else {
        bgAudio.play().then(() => {
            audioIcon.textContent = '⏸';
            audioText.textContent = 'إيقاف الموسيقى';
        }).catch(err => {
            console.log("تطلب المتصفح تفاعلاً أولاً:", err);
        });
    }
    isPlaying = !isPlaying;
});

function renderMartyrs(data) {
    martyrsGrid.innerHTML = '';
    martyrsCountEl.textContent = data.length;

    if (data.length === 0) {
        martyrsGrid.innerHTML = `<p style="grid-column: 1/-1; text-align: center; color: var(--text-muted); padding: 40px 0;">لم يتم العثور على نتائج تطابق البحث.</p>`;
        return;
    }

    data.forEach(martyr => {
        const card = document.createElement('div');
        card.className = 'martyr-card';
        card.onclick = () => openMartyrModal(martyr);

        card.innerHTML = `
            <div class="card-image-wrapper">
                <img src="${martyr.image}" alt="${martyr.name}" class="card-image" loading="lazy">
            </div>
            <div class="card-info">
                <h3 class="card-name">${martyr.name}</h3>
                <div class="card-meta">
                    <span>📍 ${martyr.residence}</span>
                    <span>🗓️ ${martyr.martyrdomDate}</span>
                </div>
            </div>
        `;
        martyrsGrid.appendChild(card);
    });
}

function openMartyrModal(martyr) {
    const sourcesHTML = martyr.sources && martyr.sources.length > 0 
        ? martyr.sources.map(src => `<li>${src}</li>`).join('')
        : '<li>لا توجد مصادر مضافة بعد.</li>';

    modalContent.innerHTML = `
        <div class="modal-header-flex">
            <img src="${martyr.image}" alt="${martyr.name}" class="modal-img">
            <div class="modal-details">
                <h2 class="modal-title">${martyr.name}</h2>
                <p class="modal-nickname">${martyr.nickname ? `اللقب: ${martyr.nickname}` : ''}</p>

                <div class="info-grid">
                    <div class="info-item"><span>مكان السكن:</span> ${martyr.residence}</div>
                    <div class="info-item"><span>العمر:</span> ${martyr.age}</div>
                    <div class="info-item"><span>تاريخ الميلاد:</span> ${martyr.dob}</div>
                    <div class="info-item"><span>تاريخ الاستشهاد:</span> ${martyr.martyrdomDate}</div>
                    <div class="info-item" style="grid-column: span 2;"><span>مكان الاستشهاد:</span> ${martyr.martyrdomPlace}</div>
                </div>
            </div>
        </div>

        <div class="story-section">
            <h3 class="story-title">📖 قصة الاستشهاد والذاكرة</h3>
            <p class="story-text">${martyr.story}</p>
        </div>

        <div class="sources-section">
            <h4 class="sources-title">🔍 مصادر التوثيق</h4>
            <ul class="sources-list">
                ${sourcesHTML}
            </ul>
        </div>
    `;

    modal.classList.add('active');
    modal.setAttribute('aria-hidden', 'false');
}

closeModalBtn.addEventListener('click', () => {
    modal.classList.remove('active');
    modal.setAttribute('aria-hidden', 'true');
});

modal.addEventListener('click', (e) => {
    if (e.target === modal) {
        modal.classList.remove('active');
        modal.setAttribute('aria-hidden', 'true');
    }
});

function filterMartyrs() {
    const searchTerm = searchInput.value.trim().toLowerCase();
    const selectedRegion = regionFilter.value;

    const filtered = martyrsData.filter(martyr => {
        const matchesName = martyr.name.toLowerCase().includes(searchTerm) || 
                            (martyr.nickname && martyr.nickname.toLowerCase().includes(searchTerm));
        const matchesRegion = selectedRegion === 'all' || martyr.residence.includes(selectedRegion);

        return matchesName && matchesRegion;
    });

    renderMartyrs(filtered);
}

searchInput.addEventListener('input', filterMartyrs);
regionFilter.addEventListener('change', filterMartyrs);

renderMartyrs(martyrsData);
