:root {
    --bg-main: #0a0b0d;
    --bg-card: #121418;
    --bg-modal: #181a20;
    --accent-gold: #c6a052;
    --accent-gold-hover: #e5bd68;
    --text-primary: #f0f2f5;
    --text-secondary: #a0a5b1;
    --text-muted: #6c727f;
    --border-color: rgba(198, 160, 82, 0.2);
    --font-title: 'Amiri', serif;
    --font-body: 'Cairo', sans-serif;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background-color: var(--bg-main);
    color: var(--text-primary);
    font-family: var(--font-body);
    line-height: 1.6;
    direction: rtl;
    -webkit-font-smoothing: antialiased;
}

.hero-section {
    position: relative;
    padding: 50px 20px 30px;
    text-align: center;
    background: radial-gradient(circle at center, #181c24 0%, var(--bg-main) 80%);
    border-bottom: 1px solid var(--border-color);
}

.audio-control-container {
    position: absolute;
    top: 15px;
    left: 15px;
}

.btn-audio {
    background: rgba(18, 20, 24, 0.8);
    border: 1px solid var(--accent-gold);
    color: var(--accent-gold);
    padding: 8px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-family: var(--font-body);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    backdrop-filter: blur(5px);
    transition: all 0.3s ease;
}

.btn-audio:active {
    transform: scale(0.95);
}

.hero-content {
    max-width: 700px;
    margin: 0 auto;
}

.symbol {
    font-size: 2.2rem;
    margin-bottom: 10px;
}

.main-title {
    font-family: var(--font-title);
    font-size: 2.5rem;
    color: var(--accent-gold);
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    font-weight: 300;
}

.gold-divider {
    height: 2px;
    width: 80px;
    background: linear-gradient(90deg, transparent, var(--accent-gold), transparent);
    margin: 20px auto 0;
}

.stats-badge {
    margin-top: 25px;
    display: inline-block;
    background: rgba(198, 160, 82, 0.08);
    border: 1px solid var(--border-color);
    padding: 6px 16px;
    border-radius: 12px;
    font-size: 0.9rem;
}

.stats-number {
    color: var(--accent-gold);
    font-weight: 700;
    margin-right: 5px;
}

.main-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 25px 15px;
}

.filter-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 30px;
}

@media (min-width: 600px) {
    .filter-section {
        flex-direction: row;
    }
}

.search-box, .select-box {
    flex: 1;
}

.search-box input, .select-box select {
    width: 100%;
    padding: 12px 16px;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.3s;
}

.search-box input:focus, .select-box select:focus {
    border-color: var(--accent-gold);
}

.martyrs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
}

.martyr-card {
    background-color: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease, border-color 0.3s ease;
}

.martyr-card:hover, .martyr-card:active {
    transform: translateY(-4px);
    border-color: var(--accent-gold);
}

.card-image-wrapper {
    width: 100%;
    height: 280px;
    background-color: #000;
    overflow: hidden;
}

.card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(20%);
    transition: filter 0.3s ease;
}

.martyr-card:hover .card-image {
    filter: grayscale(0%);
}

.card-info {
    padding: 15px;
}

.card-name {
    font-family: var(--font-title);
    font-size: 1.3rem;
    color: var(--accent-gold);
    margin-bottom: 5px;
}

.card-meta {
    font-size: 0.85rem;
    color: var(--text-secondary);
    display: flex;
    justify-content: space-between;
}

.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 15px;
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
}

.modal-overlay.active {
    opacity: 1;
    pointer-events: auto;
}

.modal-card {
    background-color: var(--bg-modal);
    border: 1px solid var(--accent-gold);
    width: 100%;
    max-width: 650px;
    max-height: 90vh;
    border-radius: 12px;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 10px 30px rgba(0,0,0,0.8);
}

.close-modal {
    position: absolute;
    top: 10px;
    left: 15px;
    background: none;
    border: none;
    color: var(--text-secondary);
    font-size: 2rem;
    cursor: pointer;
    z-index: 10;
}

.modal-body {
    padding: 25px 20px;
}

.modal-header-flex {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 20px;
}

@media (min-width: 500px) {
    .modal-header-flex {
        flex-direction: row;
    }
}

.modal-img {
    width: 100%;
    max-width: 180px;
    height: 220px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    margin: 0 auto;
}

.modal-details {
    flex: 1;
}

.modal-title {
    font-family: var(--font-title);
    font-size: 1.8rem;
    color: var(--accent-gold);
    margin-bottom: 5px;
}

.modal-nickname {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 12px;
}

.info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 15px;
    font-size: 0.88rem;
    background: rgba(0, 0, 0, 0.2);
    padding: 10px;
    border-radius: 6px;
}

.info-item span {
    color: var(--text-muted);
}

.story-section {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 15px;
    margin-top: 15px;
}

.story-title, .sources-title {
    font-family: var(--font-title);
    color: var(--accent-gold);
    font-size: 1.3rem;
    margin-bottom: 8px;
}

.story-text {
    color: var(--text-primary);
    font-size: 0.95rem;
    line-height: 1.8;
    white-space: pre-line;
}

.sources-section {
    margin-top: 20px;
    border-top: 1px dashed rgba(255,255,255,0.1);
    padding-top: 12px;
}

.sources-list {
    list-style-type: square;
    padding-right: 20px;
    font-size: 0.85rem;
    color: var(--text-secondary);
}

.footer {
    text-align: center;
    padding: 25px 15px;
    font-size: 0.8rem;
    color: var(--text-muted);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    margin-top: 40px;
}
